# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Leave blank to disable the built-in administrator login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Keep true when the public site is served over HTTPS by the reverse proxy.
SESSION_COOKIE_SECURE=true

# Comma-separated public hostnames accepted by Flask. Do not include schemes or paths.
TRUSTED_HOSTS=login.example.com,localhost,127.0.0.1,py-login
